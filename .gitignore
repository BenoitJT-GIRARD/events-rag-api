# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual env
.venv/
venv/

# Environment
.env

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data artifacts
data/raw/*
data/processed/*
data/faiss/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/faiss/.gitkeep

# The evaluation corpus is versioned on purpose: upstream is a rolling window, so
# re-ingesting would give a different corpus and no measurement here would reproduce.
!data/raw/events.json
!data/raw/SOURCE.md

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
