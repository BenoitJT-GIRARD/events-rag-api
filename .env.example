# Every setting the application reads. Each value below is the one the code falls back to
# when the variable is unset, except two, which their comments point out: the date window
# mode and the rebuild token.
#
# Copy to `.env` and fill in the API key. Everything else already has a default that runs:
# a variable is listed here because the code reads it, not because it must be set.

# --- Identity and logging ---------------------------------------------------
EVENTS_RAG_APP_NAME=Events RAG API
EVENTS_RAG_ENV=dev
EVENTS_RAG_LOG_LEVEL=INFO

# --- What the corpus covers -------------------------------------------------
# Read by the ingestion script, and the committed corpus was built with these values.
# `/metadata` also reports the location, the language and the date window. The code falls
# back to `rolling` for the date window mode; the corpus was built with `past`.
EVENTS_RAG_LOCATION_FIELD=region
EVENTS_RAG_LOCATION_VALUE=Occitanie
EVENTS_RAG_LANG=fr
EVENTS_RAG_TIMEZONE=Europe/Paris
EVENTS_RAG_DATE_WINDOW_MODE=past
EVENTS_RAG_DATE_WINDOW_DAYS=365
EVENTS_RAG_INGESTION_BATCH_SIZE=100
EVENTS_RAG_INGESTION_MAX_RECORDS=1000

# --- The paid model ---------------------------------------------------------
# The only value with no default. Embedding the corpus and answering a question both call
# Mistral; retrieval metrics need the index, so they need this too. Create the key at
# https://console.mistral.ai/api-keys; docs/operations.md says what a run spends and how
# to retire the key afterwards.
EVENTS_RAG_MISTRAL_API_KEY=
EVENTS_RAG_EMBEDDING_MODEL=mistral-embed
EVENTS_RAG_CHAT_MODEL=mistral-small-latest

# --- Where the files are ----------------------------------------------------
# All five derive from the repository root, which `events_rag.utils.paths` finds by walking up
# to the pyproject. That module also honours an `EVENTS_RAG_ROOT` override for a run against
# another checkout; it is not listed as a setting below because the application never reads
# it — the path module does, before the settings exist.
#
# `EVENTS_RAG_REPORTS_DIR` is the one to move when a run must not touch what is published,
# for instance to a directory under `var/`.
EVENTS_RAG_DATA_DIR=data
EVENTS_RAG_RAW_DATA_DIR=data/raw
EVENTS_RAG_QUESTIONS_DIR=data/questions
EVENTS_RAG_REPORTS_DIR=reports
EVENTS_RAG_INDEX_DIR=var/faiss

# --- Retrieval --------------------------------------------------------------
EVENTS_RAG_RETRIEVAL_K=5
EVENTS_RAG_CHUNK_SIZE=800
EVENTS_RAG_CHUNK_OVERLAP=120
EVENTS_RAG_FAISS_INDEX_NAME=events_index

# --- Taking the screenshots ---------------------------------------------------
# Where the headless browser is, on the machine that takes the captures. `scripts/capture.py`
# falls back to whatever `chrome` is on PATH; this is the way out when there is none, and it
# keeps one machine's installation path out of the repository.
CHROME_PATH=

# --- Operations -------------------------------------------------------------
# The token the /rebuild route asks for. The code falls back to an empty value, which
# refuses every call. The value below is a placeholder that /rebuild accepts as it stands:
# replace it before the service is exposed, for instance with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
EVENTS_RAG_REBUILD_TOKEN=change_me_local_token

# The seed that samples the evaluation set. Fixed, because two configurations compared on
# two different question sets are not compared at all.
EVENTS_RAG_EVAL_SEED=0
