# What never enters the build context.
#
# The image serves the API from the corpus. It needs the package, the scripts and data/;
# it needs neither the published results nor the index.

.git
.gitignore
.gitattributes
.github

.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

docs
tests
reports

# The FAISS index stays out of the image. docker-compose.yml mounts the local var/ at
# /app/var instead, so the container serves the index scripts/build_index.py wrote there.
var

.env
